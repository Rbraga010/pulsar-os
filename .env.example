# Pulsar OS · template .env
# Copie para bot/.env e preencha
# NUNCA commitar bot/.env real

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=cria_em_BotFather
ALLOWED_USERS=seu_user_id_telegram
TMUX_SESSION=clara
TMUX_USER=root

# --- AI provider · escolha um ---
AI_PROVIDER=anthropic
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# OU
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- Audio (opcional · Whisper + ElevenLabs) ---
# OPENAI_API_KEY=sk-...
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Vercel (opcional) ---
# VERCEL_DOMAIN=minhaloja.com.br

# --- Pulsar OS · telemetria anonima (preenche o setup.sh) ---
PULSAR_OS_INSTALL_ID=
PULSAR_OS_VERSION=0.1.0
PULSAR_OS_HEARTBEAT_URL=https://pulsarh.com.br/api/pulsar-os/heartbeat
