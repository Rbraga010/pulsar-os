# ──────────────────────────────────────────────────────────────────
# Clara · arquivo .env do lojista
# ──────────────────────────────────────────────────────────────────
#
# Como usar:
#   1. cp .env.example .env
#   2. Abre o .env e preenche o que pede
#   3. docker compose up -d
#
# Tudo que tá comentado (com #) é OPCIONAL · só preenche quando for usar.


# ──────────────────────────────────────────────────────────────────
# OBRIGATÓRIO · sem isso a Clara não sobe
# ──────────────────────────────────────────────────────────────────

# Token do bot do Telegram que vai virar a Clara.
# Como pegar: fala com o @BotFather no Telegram, manda /newbot, segue 4 passos.
# Cola aqui só a parte depois do dois-pontos · sem aspas.
TELEGRAM_BOT_TOKEN=

# Seu chat_id no Telegram · o ID numérico da sua conta.
# Como pegar: fala com o @userinfobot no Telegram, ele te manda o teu ID.
# Isso garante que SÓ você consegue conversar com a Clara (pairing).
CHAT_ID_OWNER=


# ──────────────────────────────────────────────────────────────────
# OPCIONAL · plugando capacidades extras (só quando for usar)
# ──────────────────────────────────────────────────────────────────

# image-gen · Clara gera imagem por prompt (Imagen 4 do Google)
# Grátis até quota generosa. Como pegar: https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY=

# tts · Clara manda áudio voz feminina PT-BR
# Opção A · Google TTS (grátis 4M chars/mês): bota o caminho do JSON do service account aqui
# GOOGLE_APPLICATION_CREDENTIALS=/workspace/data/gcp-tts.json
# Opção B · OpenAI TTS fallback (você já paga ChatGPT? aproveita)
# OPENAI_API_KEY=

# websearch premium · usa Brave Search ao invés do DuckDuckGo grátis
# Free tier: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
